@{
    var rol = User.FindFirstValue(ClaimTypes.Role);
    var nombre = User.FindFirstValue(ClaimTypes.Name);
    var esAdmin = rol == "Administrador";
    var esGerente = rol == "Administrador" || rol == "Gerente";
    var esInventario = esGerente || rol == "Inventario";
    var esVendedor = esGerente || rol == "Vendedor";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Exclusivo ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">EXCLUSIVO ERP</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Panel</a></li>
                    @if (esVendedor)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Sales" asp-action="Create">Punto de venta</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Sales" asp-action="Index">Ventas</a></li>
                    }
                    @if (esInventario)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Inventory" asp-action="Index">Inventario</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Productos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Warehouses" asp-action="Index">Almacenes</a></li>
                    }
                    @if (esGerente)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Suppliers" asp-action="Index">Proveedores</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reportes</a></li>
                    }
                    @if (esAdmin)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Users" asp-action="Index">Usuarios</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item"><span class="navbar-text text-light me-3">@nombre (@rol)</span></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button class="btn btn-outline-light btn-sm" type="submit">Salir</button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4">
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show">@mensaje<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center text-muted py-4 mt-4 small">Exclusivo ERP · .NET 8 · Docker · GitHub Actions · Railway</footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
