@{
    var rol = User.FindFirstValue(ClaimTypes.Role);
    var nombre = User.FindFirstValue(ClaimTypes.Name);
    var esAdmin = rol == "Administrador";
    var esGerente = rol == "Administrador" || rol == "Gerente";
    var esInventario = esGerente || rol == "Inventario";
    var esVendedor = esGerente || rol == "Vendedor";

    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    Func<string, string> activo = c => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    Func<string, string, string> activoEn = (c, a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var homeActivo = activo("Home");
    var salesCreateActivo = activoEn("Sales", "Create");
    var salesIndexActivo = activo("Sales") == "active" && salesCreateActivo != "active" ? "active" : "";
    var customersActivo = activo("Customers");
    var inventoryActivo = activo("Inventory");
    var productsActivo = activo("Products");
    var warehousesActivo = activo("Warehouses");
    var suppliersActivo = activo("Suppliers");
    var reportsActivo = activo("Reports");
    var usersActivo = activo("Users");
    var titulo = ViewData["Title"]?.ToString() ?? "Panel de control";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Exclusivo APP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <aside class="app-sidebar" id="appSidebar" aria-label="Menú principal">
        <a class="app-brand" asp-controller="Home" asp-action="Index" data-sidebar-close>
            <span class="app-brand-mark">E</span>
            <span>EXCLUSIVO<small>APP · ERP</small></span>
        </a>

        <nav class="nav flex-column app-nav">
            <div class="app-nav-section">Panel</div>
            <a class="nav-link @homeActivo" asp-controller="Home" asp-action="Index" data-sidebar-close>
                <i class="bi bi-speedometer2"></i><span>Dashboard</span>
            </a>

            @if (esVendedor)
            {
                <div class="app-nav-section">Ventas</div>
                <a class="nav-link @salesCreateActivo" asp-controller="Sales" asp-action="Create" data-sidebar-close>
                    <i class="bi bi-cart-plus"></i><span>Punto de venta</span>
                </a>
                <a class="nav-link @salesIndexActivo" asp-controller="Sales" asp-action="Index" data-sidebar-close>
                    <i class="bi bi-receipt"></i><span>Ventas</span>
                </a>
                <a class="nav-link @customersActivo" asp-controller="Customers" asp-action="Index" data-sidebar-close>
                    <i class="bi bi-people"></i><span>Clientes</span>
                </a>
            }

            @if (esInventario)
            {
                <div class="app-nav-section">Inventariado</div>
                <a class="nav-link @inventoryActivo" asp-controller="Inventory" asp-action="Index" data-sidebar-close>
                    <i class="bi bi-boxes"></i><span>Inventario</span>
                </a>
                <a class="nav-link @productsActivo" asp-controller="Products" asp-action="Index" data-sidebar-close>
                    <i class="bi bi-box-seam"></i><span>Productos</span>
                </a>
                <a class="nav-link @warehousesActivo" asp-controller="Warehouses" asp-action="Index" data-sidebar-close>
                    <i class="bi bi-house-door"></i><span>Almacenes</span>
                </a>
            }

            @if (esGerente)
            {
                <div class="app-nav-section">Compras y reportes</div>
                <a class="nav-link @suppliersActivo" asp-controller="Suppliers" asp-action="Index" data-sidebar-close>
                    <i class="bi bi-truck"></i><span>Proveedores</span>
                </a>
                <a class="nav-link @reportsActivo" asp-controller="Reports" asp-action="Index" data-sidebar-close>
                    <i class="bi bi-bar-chart-line"></i><span>Reportes</span>
                </a>
            }

            @if (esAdmin)
            {
                <div class="app-nav-section">Administración</div>
                <a class="nav-link @usersActivo" asp-controller="Users" asp-action="Index" data-sidebar-close>
                    <i class="bi bi-people"></i><span>Usuarios</span>
                </a>
            }
        </nav>
    </aside>

    <div class="app-wrapper">
        <header class="app-topbar">
            <button class="btn-menu d-lg-none" type="button" data-sidebar-toggle aria-label="Abrir menú">
                <i class="bi bi-list"></i>
            </button>
            <span class="app-topbar-title">@titulo</span>

            <div class="ms-auto d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="app-user d-none d-sm-block">
                        @nombre
                        <small>@rol</small>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                        <button class="btn btn-app-outline btn-sm" type="submit">
                            <i class="bi bi-box-arrow-right"></i> Salir
                        </button>
                    </form>
                }
            </div>
        </header>

        <main class="app-content" role="main">
            @if (TempData["Mensaje"] is string mensaje)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle me-2"></i>@mensaje
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle me-2"></i>@error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var sidebar = document.getElementById('appSidebar');
            var backdrop = document.getElementById('sidebarBackdrop');

            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            }

            document.addEventListener('click', function (e) {
                if (e.target.closest('[data-sidebar-toggle]')) {
                    sidebar.classList.add('show');
                    backdrop.classList.add('show');
                    return;
                }
                if (e.target.closest('[data-sidebar-close]') || e.target === backdrop) {
                    closeSidebar();
                }
            });

            window.addEventListener('resize', function () {
                if (window.innerWidth >= 992) closeSidebar();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
