@model List<Almacen>
@{
    ViewData["Title"] = "Almacenes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Almacenes y sucursales</h1>
    <a class="btn btn-app" asp-action="Create">Nuevo almacén</a>
</div>
<div class="card p-3">
    <table class="table align-middle">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Nombre</td>
                    <td>@a.Descripcion</td>
                    <td><span class="badge bg-@(a.Activo ? "success" : "secondary")">@(a.Activo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Editar</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>
