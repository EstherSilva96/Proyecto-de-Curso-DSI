@model List<Almacen>
@{
    ViewData["Title"] = "Almacenes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Almacenes y sucursales</h1>
    <a class="btn btn-app" asp-action="Create">Nuevo almacén</a>
</div>
<div class="card p-3">
    <table class="table align-middle">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Nombre</td>
                    <td>@a.Descripcion</td>
                    <td><span class="badge bg-@(a.Activo ? "success" : "secondary")">@(a.Activo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@a.Id">Editar</a>
                        <form asp-action="Toggle" asp-route-id="@a.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-secondary" type="submit">@(a.Activo ? "Desactivar" : "Activar")</button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline"
                              onsubmit="return confirm('¿Eliminar el almacén @a.Nombre?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
