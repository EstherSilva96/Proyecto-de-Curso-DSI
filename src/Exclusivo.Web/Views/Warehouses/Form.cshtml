@model Almacen
@{
    ViewData["Title"] = Model.Id == 0 ? "Nuevo almacén" : "Editar almacén";
}
<h1 class="h3 mb-3">@ViewData["Title"]</h1>
<div class="card p-4" style="max-width: 700px">
    <form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="text-danger small"></div>
        <div class="mb-3"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger small"></span></div>
        <div class="mb-3"><label asp-for="Descripcion" class="form-label"></label><input asp-for="Descripcion" class="form-control" /></div>
        <div class="form-check mb-3"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label"></label></div>
        <button class="btn btn-app" type="submit">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>
