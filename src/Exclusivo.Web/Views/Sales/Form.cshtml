+@model VentaCreateViewModel
@{
    ViewData["Title"] = "Punto de venta";
    var variantes = (List<VarianteProducto>)ViewBag.Variantes;
}
<h1 class="h3 mb-3">Punto de venta</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger small"></div>
    <div class="card p-3 mb-3">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="ClienteId" class="form-label">Cliente</label>
                <select asp-for="ClienteId" asp-items="ViewBag.Clientes" class="form-select"><option value="">Cliente general</option></select>
                <button type="button" id="abrir-nuevo-cliente" class="btn btn-sm btn-outline-primary mt-2">Nuevo cliente</button>
            </div>
            <div class="col-md-4">
                <label asp-for="AlmacenId" class="form-label">Almacén</label>
                <select asp-for="AlmacenId" asp-items="ViewBag.Almacenes" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="MetodoPago" class="form-label">Método de pago</label>
                <select asp-for="MetodoPago" class="form-select">
                    <option>Efectivo</option><option>Tarjeta</option><option>Transferencia</option>
                </select>
            </div>
            <div class="col-md-4">
                <label asp-for="Descuento" class="form-label">Descuento (C$)</label>
                <input asp-for="Descuento" class="form-control" type="number" step="0.01" value="0" />
            </div>
        </div>
    </div>

    <div class="card p-3">
        <h2 class="h5">Productos disponibles</h2>
        <table class="table table-sm align-middle">
            <thead><tr><th>SKU</th><th>Producto</th><th>Variante</th><th class="text-end">Precio</th><th class="text-end">Stock en almacén</th><th class="text-end">Cantidad</th></tr></thead>
            <tbody>
                @for (var i = 0; i < variantes.Count; i++)
                {
                    var v = variantes[i];
                    var stockPorAlmacen = v.Existencias
                        .GroupBy(e => e.AlmacenId)
                        .ToDictionary(g => g.Key, g => g.Sum(e => e.Cantidad));
                    var stock = stockPorAlmacen.GetValueOrDefault(Model.AlmacenId);
                    <tr>
                        <td><small>@v.Producto.Sku</small></td>
                        <td>@v.Producto.Nombre</td>
                        <td>@v.Color / @v.Talla</td>
                        <td class="text-end">C$ @v.Producto.Precio.ToString("N2")</td>
                        <td class="text-end" data-stock-disponible>@stock</td>
                        <td class="text-end" style="width: 120px">
                            <input type="hidden" name="Items[@i].VarianteProductoId" value="@v.Id" />
                            <input name="Items[@i].Cantidad" class="form-control form-control-sm text-end" type="number" min="0" max="@stock" value="0"
                                   data-stock-por-almacen="@System.Text.Json.JsonSerializer.Serialize(stockPorAlmacen)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button class="btn btn-dark" type="submit">Confirmar venta</button>
        <a class="btn btn-secondary" asp-controller="Home" asp-action="Index">Cancelar</a>
    </div>
</form>

<script>
    (() => {
        const almacen = document.getElementById("AlmacenId");
        const cantidades = document.querySelectorAll("input[data-stock-por-almacen]");
        if (!almacen) return;

        function actualizarStock() {
            cantidades.forEach(cantidad => {
                const existencias = JSON.parse(cantidad.dataset.stockPorAlmacen);
                const stock = existencias[almacen.value] ?? 0;
                cantidad.closest("tr").querySelector("[data-stock-disponible]").textContent = stock;
                cantidad.max = stock;
            });
        }

        almacen.addEventListener("change", actualizarStock);
        actualizarStock();
    })();
</script>
<dialog id="nuevo-cliente-dialog" class="border-0 rounded-3 shadow p-4">
    <h2 class="h5">Registrar cliente</h2>

    <form id="nuevo-cliente-form"
          asp-controller="Sales"
          asp-action="RegistrarCliente"
          method="post">

        <div id="nuevo-cliente-error"
             class="alert alert-danger d-none"
             role="alert"></div>

        <label for="nuevo-cliente-nombre" class="form-label">
            Nombre del cliente
        </label>

        <input id="nuevo-cliente-nombre"
               name="nombreCliente"
               class="form-control"
               required
               maxlength="150"
               autocomplete="name"
               autofocus />

        <div class="d-flex gap-2 mt-3">
            <button id="guardar-nuevo-cliente"
                    type="submit"
                    class="btn btn-primary">
                Guardar cliente
            </button>

            <button id="cancelar-nuevo-cliente"
                    type="button"
                    class="btn btn-secondary">
                Cancelar
            </button>
        </div>
    </form>
</dialog>

<script>
    (() => {
        const dialogo = document.getElementById("nuevo-cliente-dialog");
        const formulario = document.getElementById("nuevo-cliente-form");
        const guardar = document.getElementById("guardar-nuevo-cliente");
        const error = document.getElementById("nuevo-cliente-error");
        const clientes = document.getElementById("ClienteId");

        document.getElementById("abrir-nuevo-cliente")
            .addEventListener("click", () => {
                error.classList.add("d-none");
                dialogo.showModal();
            });

        document.getElementById("cancelar-nuevo-cliente")
            .addEventListener("click", () => dialogo.close());

        formulario.addEventListener("submit", async evento => {
            evento.preventDefault();
            if (guardar.disabled) return;

            guardar.disabled = true;
            error.classList.add("d-none");

            try {
                const respuesta = await fetch(formulario.action, {
                    method: "POST",
                    body: new FormData(formulario),
                    credentials: "same-origin",
                    headers: { "Accept": "application/json" }
                });

                if (!respuesta.headers.get("content-type")?.includes("application/json"))
                    throw new Error("Revise su sesión e inténtelo de nuevo.");

                const datos = await respuesta.json();

                if (!respuesta.ok)
                    throw new Error(datos.mensaje || "No se pudo guardar el cliente.");

                clientes.add(new Option(datos.nombre, datos.id, true, true));
                formulario.reset();
                dialogo.close();
            } catch (fallo) {
                error.textContent = fallo instanceof TypeError
                    ? "No se pudo conectar. Inténtelo de nuevo."
                    : fallo.message || "No se pudo guardar el cliente.";

                error.classList.remove("d-none");
            } finally {
                guardar.disabled = false;
            }
        });
    })();
</script>
