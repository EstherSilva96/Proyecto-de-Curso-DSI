@model List<Usuario>
@{
    ViewData["Title"] = "Usuarios";
    var usuarioActual = User.Identity?.Name;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Usuarios y roles</h1>
    <a class="btn btn-app" asp-action="Create">Nuevo usuario</a>
</div>
<div class="card p-3">
    <table class="table align-middle">
        <thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Último acceso</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.NombreUsuario</td>
                    <td>@u.Nombres @u.Apellidos</td>
                    <td><span class="badge bg-info text-dark">@u.Rol</span></td>
                    <td>@(u.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                    <td><span class="badge bg-@(u.Activo ? "success" : "secondary")">@(u.Activo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Editar</a>
                        @if (string.Equals(u.NombreUsuario, usuarioActual, StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="text-muted small d-inline-block ms-2" title="Rol protegido">
                                Consulte con el ingeniero de sistemas para modificar este rol
                            </span>
                        }
                        else
                        {
                            <form asp-action="Toggle" asp-route-id="@u.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">@(u.Activo ? "Desactivar" : "Activar")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
