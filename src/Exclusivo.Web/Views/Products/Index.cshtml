@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Catálogo de productos</h1>
    <a class="btn btn-app" asp-action="Create">Nuevo producto</a>
</div>
<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead><tr><th>SKU</th><th>Producto</th><th>Categoría</th><th>Marca</th><th class="text-end">Costo</th><th class="text-end">Precio</th><th>Margen</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><small>@p.Sku</small></td>
                    <td>@p.Nombre</td>
                    <td>@p.Categoria?.Nombre</td>
                    <td>@p.Marca?.Nombre</td>
                    <td class="text-end">C$ @p.Costo.ToString("N2")</td>
                    <td class="text-end">C$ @p.Precio.ToString("N2")</td>
                    <td>C$ @(p.Precio - p.Costo).ToString("N2")</td>
                    <td><span class="badge bg-@(p.Estado == "Activo" ? "success" : "secondary")">@p.Estado</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                        @if (p.Estado == "Activo")
                        {
                            <form asp-action="Descontinuar" asp-route-id="@p.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Descontinuar</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
