@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Catálogo de productos</h1>
    <a class="btn btn-app" asp-action="Create">Nuevo producto</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6 col-lg-4">
        <input class="form-control" type="search" name="buscar" value="@ViewBag.Buscar" placeholder="Buscar producto por nombre" aria-label="Buscar producto por nombre" />
    </div>
    <div class="col-auto">
        <button class="btn btn-app" type="submit">Buscar</button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Buscar))
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
        }
    </div>
</form>
<div class="card p-3">
    <table class="table table-hover align-middle">
        <thead><tr><th>STOCK</th><th>Producto</th><th>Categoría</th><th>Marca</th><th class="text-end">Costo</th><th class="text-end">Precio</th><th>Margen</th><th>Estado</th><th></th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="9" class="text-center text-muted py-4">No se encontraron productos con ese nombre.</td></tr>
            }
            @foreach (var p in Model)
            {
                <tr>
                    <td><small>@p.Stock</small></td>
                    <td>@p.Nombre</td>
                    <td>@p.Categoria?.Nombre</td>
                    <td>@p.Marca?.Nombre</td>
                    <td class="text-end">C$ @p.Costo.ToString("N2")</td>
                    <td class="text-end">C$ @p.Precio.ToString("N2")</td>
                    <td>C$ @(p.Precio - p.Costo).ToString("N2")</td>
                    <td><span class="badge bg-@(p.Estado == "Activo" ? "success" : "secondary")">@p.Estado</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Editar</a>
                        <form asp-action="Toggle" asp-route-id="@p.Id" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-secondary" type="submit">@(p.Estado == "Activo" ? "Descontinuar" : "Activar")</button>
                        </form>
                        <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('¿Eliminar el producto @p.Nombre?');">
                            <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
