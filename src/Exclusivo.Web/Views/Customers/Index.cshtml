@model List<Cliente>
@{
    ViewData["Title"] = "Clientes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Clientes</h1>
    <a class="btn btn-app" asp-action="Create">Nuevo cliente</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6 col-lg-4">
        <input class="form-control" type="search" name="buscar" value="@ViewBag.Buscar"
               placeholder="Buscar cliente por nombre, cédula o teléfono"
               aria-label="Buscar cliente" />
    </div>
    <div class="col-auto">
        <button class="btn btn-app" type="submit">Buscar</button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Buscar))
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
        }
    </div>
</form>

<div class="card p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Dirección</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No se encontraron clientes.</td></tr>
                }
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Nombre</td>
                        <td>@(c.Cedula ?? c.Documento)</td>
                        <td>@(c.Telefono ?? "-")</td>
                        <td>@(c.Correo ?? "-")</td>
                        <td>@(c.Direccion ?? "-")</td>
                        <td><span class="badge bg-@(c.Activo ? "success" : "secondary")">@(c.Activo ? "Activo" : "Inactivo")</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
                            <form asp-action="Toggle" asp-route-id="@c.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary" type="submit">@(c.Activo ? "Desactivar" : "Activar")</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar el cliente @c.Nombre?');">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
